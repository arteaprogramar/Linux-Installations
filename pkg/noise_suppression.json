        },
        "warning" : null
    },
    {
        "action" : "Descomprimir archivo",
        "command" : "unzip temp/linux-rnnoise.zip -d temp",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Mover a LADSPA",
        "command" : "sudo mkdir -p /usr/lib64/ladspa; sudo cp temp/linux-rnnoise/ladspa/librnnoise_ladspa.so /usr/lib64/ladspa",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Crear archivo de congfiguración para el cancelador mediante Pipewire",
        "command" : "mkdir -p ~/.config/pipewire/pipewire.conf.d; cp files/noise-suppression-99-input-denoising.conf ~/.config/pipewire/pipewire.conf.d/99-input-denoising.conf",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Reiniciar servicio de Pipewire para mostrar el cancelador como nuevo metodo de entrada en ajustes",
        "command" : "systemctl restart --user pipewire.service",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Verificar estado del servicio Pipewire",
        "command" : "systemctl status --user pipewire.service",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
