    {
        "action" : "Comprobar si existe el paquete CURL",
        "command" : "curl --version",
        "command_alternative" : null,
        "required_output" : true,
        "extra" : {
            "name" : "--pkg-exists",
            "param" : null
        },
        "warning" : "Si el paquete CURL no existe en su SO favor de descargarlo"
    },{
        "action" : "Comprobar si existe el paquete Java",
        "command" : "java -version",
        "command_alternative" : null,
        "required_output" : true,
        "extra" : {
            "name" : "--pkg-exists",
            "param" : null
        },
        "warning" : "Se requiere JAVA para instalar Gradle"
    },
    {
        "action" : "Actualizar sistema",
        "command" : null,
        "command_alternative" : {
            "dnf" : "sudo dnf -y upgrade",
            "apt" : "sudo apt update; sudo apt -y upgrade",
            "pacman" : "sudo pacman -Syu --noconfirm"
        },
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Obtener versiones disponibles de Gradle",
        "command" : "  versions=($(curl -s https://raw.githubusercontent.com/gradle/gradle/master/released-versions.json | grep -oP '\"version\":\\s*\"\\K[0-9.]+' | head -n 20));   printf '%s\\n' \"${versions[@]}\"  ",
        "command_alternative" : null,
        "required_output" : true,
        "extra" : {
            "name" : "Lista de versiones disponibles",
            "param" : null
        },
        "warning" : null
    },
    {
        "action" : "Descarga de Gradle",
        "command" : null,
        "command_alternative" : null,
        "required_output" : false,
        "extra" : {
            "name" : "--download",
            "param" : "https://services.gradle.org/distributions/gradle-{version}-all.zip"
        },
        "warning" : null
    },
    {
        "action" : "Descomprimir archivo",
        "command" : "unzip temp/gradle-{version}-all.zip -d temp",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Mover a OPT",
        "command" : "sudo mv temp/gradle-{version} /opt/Gradle",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Agregar al PATH de Linux y dar permisos de ejecución a Gradle",
        "command" : "sudo cp files/path-gradle.sh /etc/profile.d/gradle.sh; sudo chmod +x /etc/profile.d/gradle.sh",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    },
    {
        "action" : "Se require su contraseña para aplicar el comando '$ source /etc/profile.d/gradle.sh'",
        "command" : "su -c 'source /etc/profile.d/gradle.sh' root",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : "En caso de no ingresar de manera exitosa su contraseña, favor de ejecutar manualmente $ source /etc/profile.d/gradle.sh"
    },
    {
        "action" : "En algunas distribuciones requiere reiniciar el sistema",
        "command" : "/opt/Gradle/bin/gradle --version",
        "command_alternative" : null,
        "required_output" : false,
        "extra" : null,
        "warning" : null
    }
]